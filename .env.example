# Local default for the main workflow: call real cloud services.
# Tests override this to true internally.
DEMO_MODE=false

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
# Leave unset locally unless you intentionally want to override API_PORT.
PORT=
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=

# Frontend
# BACKEND_URL is used by Next.js rewrites in services/ui/next.config.mjs.
BACKEND_URL=http://localhost:8000
# Kept for compatibility with older deploy settings.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Dataset-scale Phase 1 rules
# Recommended: run `python evaluation\push_seed_data.py` once, then keep this
# false so starting the API does not wipe/reseed cloud databases every time.
AUTO_SEED_ON_STARTUP=false
INSTANT_ALLOW_MAX=5000
ELEVATED_AMOUNT_THRESHOLD=5000
LARGE_AMOUNT_THRESHOLD=1000000
SUSPICIOUS_VELOCITY_THRESHOLD=5
HIGH_RISK_THRESHOLD=0.6
RED_RISK_THRESHOLD=0.9

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash
GEMINI_API_KEY_PLANNER=
GEMINI_API_KEY_EXECUTOR=
GEMINI_API_KEY_EXECUTOR_POOL=
GEMINI_API_KEY_DETECTIVE=
GEMINI_API_KEY_VISION=
GEMINI_API_KEY_REPORT=

# Neo4j AuraDB
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Windows/Python can fail CA verification for some AuraDB cert chains.
# Keep true for demos; set false if your environment verifies neo4j+s cleanly.
NEO4J_ALLOW_SELF_SIGNED_FALLBACK=true

# ChromaDB Cloud
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION_NAME=fraud_knowledge_base

# Redis Cloud
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=fraud_detection

# Legacy DynamoDB simulator naming retained for internal fallback code
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_TRANSACTIONS=fraud_transactions
DYNAMODB_TABLE_PROFILES=customer_profiles
